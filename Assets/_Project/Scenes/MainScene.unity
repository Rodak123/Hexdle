      m_Calls: []
  m_text: "<size=25>LUCKY NUMBER</size>\nis a number that helps you find the target
    SPELL. It's in the middle of the RUNE TABLE and It's picked based on these four
    rules:\n 1. No repeating letters = Is even\n 2. First letter is in the first
    half of the alphabet = Is less than 40\n 3. Word has 5 letters = Second digit
    is less than or equal to 5\n 4. Word ends with a vowel = First digit is a prime
    number (2, 3, 5, 7)"
